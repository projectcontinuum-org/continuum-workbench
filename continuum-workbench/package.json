{
  "private": true,
  "name": "@continuum/workbench",
  "version": "0.0.16",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@continuum/core": "*",
    "@continuum/workflow-builder-extension": "*",
    "@continuum/workflow-editor-extension": "*",
    "@theia/ai-chat": "1.74.1",
    "@theia/ai-chat-ui": "1.74.1",
    "@theia/ai-claude-code": "1.74.1",
    "@theia/ai-code-completion": "1.74.1",
    "@theia/ai-core": "1.74.1",
    "@theia/ai-core-ui": "1.74.1",
    "@theia/ai-history": "1.74.1",
    "@theia/ai-ollama": "1.74.1",
    "@theia/core": "1.74.1",
    "@theia/filesystem": "1.74.1",
    "@theia/keymaps": "1.74.1",
    "@theia/markers": "1.74.1",
    "@theia/messages": "1.74.1",
    "@theia/monaco": "1.74.1",
    "@theia/navigator": "1.74.1",
    "@theia/plugin-ext": "1.74.1",
    "@theia/plugin-ext-vscode": "1.74.1",
    "@theia/preferences": "1.74.1",
    "@theia/process": "1.74.1",
    "@theia/scm": "1.74.1",
    "@theia/scm-extra": "1.74.1",
    "@theia/workspace": "1.74.1"
  },
  "devDependencies": {
    "@theia/cli": "1.74.1",
    "monaco-editor-webpack-plugin": "^7.1.0",
    "terser-webpack-plugin": "5.3.10"
  },
  "scripts": {
    "download:plugins": "node ../scripts/install-pinned-plugins.js && theia download:plugins --rate-limit=15 --parallel=false",
    "seed:kotlin-settings": "node ../scripts/seed-kotlin-settings.js",
    "download:kotlin-ls": "../scripts/download-kotlin-ls.sh",
    "build": "theia build --mode=development",
    "build:prd": "theia build --mode=production",
    "build:dev": "theia build --mode=development",
    "rebuild": "theia rebuild:browser --cacheRoot ..",
    "start": "(node ../scripts/seed-kotlin-settings.js || true) && theia start --plugins=local-dir:./plugins --port 3003",
    "watch": "yarn rebuild && theia build --watch --mode development"
  },
  "theiaPluginsDir": "plugins",
  "theiaPlugins": {
    "vscode.git": "https://github.com/eclipse-theia/vscode-builtin-extensions/releases/download/1.108.2/vscode.git.vsix",
    "vscode.git-base": "https://github.com/eclipse-theia/vscode-builtin-extensions/releases/download/1.108.2/vscode.git-base.vsix",
    "fwcd.kotlin": "https://open-vsx.org/api/fwcd/kotlin/0.2.36/file/fwcd.kotlin-0.2.36.vsix"
  },
  "pluginChecksums": {
    "fwcd.kotlin": "79be50d4de08f29e0fabe30e9ee094eb86ce5eeae28bdd02bcc6dc6593453a2d"
  },
  "theia": {
    "target": "browser",
    "frontend": {
      "config": {
        "applicationName": "Continuum",
        "defaultTheme": {
          "light": "continuum-light",
          "dark": "continuum-dark"
        },
        "defaultIconTheme": "theia-file-icons",
        "reloadOnReconnect": true
      }
    },
    "backend": {
      "config": {
        "configurationFolder": ".continuum"
      }
    },
    "generator": {
      "config": {
        "preloadTemplate": "resources/preload.html"
      }
    }
  }
}
