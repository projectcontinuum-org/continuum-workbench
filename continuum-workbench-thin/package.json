{
    "private": true,
    "name": "@continuum/workbench-thin",
    "version": "0.0.16",
    "license": "",
    "theia": {
        "target": "browser-only",
        "frontend": {
            "config": {
                "applicationName": "Continuum",
                "defaultTheme": {
                    "light": "continuum-light",
                    "dark": "continuum-dark"
                },
                "defaultIconTheme": "theia-file-icons",
                "reloadOnReconnect": true,
                "preferences": {
                    "files.enableTrash": false
                }
            }
        },
        "backend": {
            "config": {
                "configurationFolder": ".continuum"
            }
        },
        "generator": {
            "config": {
                "preloadTemplate": "resources/preload.html"
            }
        }
    },
    "dependencies": {
        "@theia/core": "1.74.1",
        "@theia/filesystem": "1.74.1",
        "@theia/markers": "1.74.1",
        "@theia/messages": "1.74.1",
        "@theia/monaco": "1.74.1",
        "@theia/navigator": "1.74.1",
        "@theia/preferences": "1.74.1",
        "@theia/process": "1.74.1",
        "@theia/workspace": "1.74.1",
        "@continuum/core": "*",
        "@continuum/workflow-editor-extension": "*"
    },
    "scripts": {
        "build": "yarn rebuild && theia build --mode development",
        "rebuild": "theia rebuild:browser --cacheRoot ..",
        "start": "theia start --plugins=local-dir:./plugins",
        "watch": "yarn rebuild && theia build --watch --mode development",
        "clean": "theia clean"
    },
    "devDependencies": {
        "@theia/cli": "1.74.1",
        "monaco-editor-webpack-plugin": "^7.1.0",
        "terser-webpack-plugin": "5.3.10"
    }
}
